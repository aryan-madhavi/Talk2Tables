# ============================================================
# Talk2Tables — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# ── Firebase Service Account ──────────────────────────────────────────────────
# Download from: Firebase Console → Project Settings → Service Accounts
#                → Generate new private key → open the .json file → paste
#                  its entire contents as a single line below (no newlines).
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Firestore collection names (optional — change only if you renamed them) ───
# FIRESTORE_USERS_COLLECTION=users
# FIRESTORE_SESSIONS_COLLECTION=sessions
# SESSION_EXPIRY_SECONDS=28800  # 8 hours (default)

# ── Database Password Encryption ──────────────────────────────────────────────
# AES-256-GCM key for encrypting DB passwords stored in Firestore.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
DB_ENCRYPTION_KEY=your_64_char_hex_key_here

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Priority order: openrouter → groq → gemini → ollama
# Set LLM_PROVIDER to pin a specific provider; otherwise the cascade is used.
LLM_PROVIDER=gemini

# OpenRouter (PRIMARY — broadest model choice)
# Get key at: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Must support tool/function calling. Recommended: openai/gpt-4o-mini, anthropic/claude-3-haiku
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq (SECONDARY — LPU-accelerated, ~1.5s response)
# Get key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen-2.5-coder-32b

# Google Gemini (TERTIARY — free tier, Hindi support, used in n8n prototype)
# Get key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama (OPTIONAL — local/offline, no key needed)
# Setup: docker exec ollama ollama pull qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# ── Agent Behaviour ───────────────────────────────────────────────────────────
MAX_HISTORY_TURNS=6       # Conversation turns injected into LLM context (user+assistant pairs)
MAX_QUERY_ROWS=10000      # Hard cap on SELECT results returned
MAX_SCHEMA_CHARS=12000    # Max characters of schema DDL sent to LLM (~3000 tokens)
AGENT_MAX_RETRIES=3       # Output-parser retries on JSON parse failure

# ── Redis Cache (optional) ────────────────────────────────────────────────────
# Leave blank to disable — app falls back to Firestore on every read.
# Local dev:  redis://localhost:6379/0
# Railway:    add a Redis plugin to your project — Railway injects REDIS_URL automatically.
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Debug (Swagger UI) ────────────────────────────────────────────────────────
# Set to true to expose /docs and /redoc. Keep false (or unset) in production.
DEBUG=true
