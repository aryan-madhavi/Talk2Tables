# ========================================================
# Talk2Tables — On-Premise Environment Variables# ===========================================================# ── 1. Authentication (Local JWT) ──────────────────────────────────────────# Generate key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"JWT_SECRET_KEY=your_secure_32_char_token_hereJWT_ALGORITHM=HS256ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# ── 2. Databases (Local) ───────────────────────────────────────────────────
# MongoDB (Users, Chats, Sessions, Connections)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=talk2tables_db
# Redis (Session Revocation & Schema Cache)
REDIS_URL=redis://localhost:6379/0
# ── 3. Database Password Encryption ────────────────────────────────────────
# AES-256 Key to encrypt your connected database passwords in MongoDB.
# Generate key: python3 -c "import secrets; print(secrets.token_hex(32))"
DB_ENCRYPTION_KEY=your_64_char_hex_key_here
# ── 4. Local AI (Ollama) ───────────────────────────────────────────────────
# Pinning to Ollama ensures NO data leaves your server for Gemini/OpenRouter.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# ── 5. Agent Settings ──────────────────────────────────────────────────────
MAX_HISTORY_TURNS=6
MAX_QUERY_ROWS=1000
MAX_SCHEMA_CHARS=12000
AGENT_MAX_RETRIES=3
# ── 6. Debug & CORS ────────────────────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://your-production-domain.com