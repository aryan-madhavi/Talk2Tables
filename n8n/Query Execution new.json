    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  // Parse the stringified JSON from output field\n  const parsed = JSON.parse(item.json.output);\n\n  results.push({\n    json: {\n      sql_query:            parsed.sql_query,\n      summary:              parsed.summary,\n      total_records:        parsed.numerical_insights.total_records,\n      numerical_insights:   parsed.numerical_insights,\n      data:                 parsed.data\n    }\n  });\n}\n\nreturn results;"
      },
